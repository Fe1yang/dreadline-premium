; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/enabled=false
general/ios/app_id="ca-app-pub-3341507214983966~4803691884"

[application]

config/name="Dreadline:Zombie Apocalypse"
config/description="A 3D zombie runner with manual aiming, collectible weapons and supplies."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.023529412, 0.047058824, 0.043137256, 1)
config/icon="res://assets/icons/icon-1024.png"

run/max_fps=60
[audio]

default_bus_layout="res://assets/default_bus_layout.tres"

[autoload]

BootTrace="*res://scripts/boot_trace.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation=1
window/size/min_width=360
window/size/min_height=640

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.025, 0.047, 0.043, 1)

anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1