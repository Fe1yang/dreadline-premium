static func text(code: String,key: String) -> String:
	var table: Dictionary=STRINGS.get(code,STRINGS["en"])
	return table.get(key,STRINGS["en"].get(key,key))

static func native_name(code: String) -> String:
	for item in LANGUAGES:
		if item.code==code: return item.native
	return "English"
