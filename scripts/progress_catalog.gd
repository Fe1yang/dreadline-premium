## Picks `count` missions from `pool`, the same for everyone on the same day / event window.
static func pick(pool: Array,count: int,seed_key: String) -> Array:
	var r:=RandomNumberGenerator.new(); r.seed=hash(seed_key)
	var order:=range(pool.size())
	for i in range(order.size()-1,0,-1):
		var j:=r.randi_range(0,i); var t=order[i]; order[i]=order[j]; order[j]=t
	var out:=[]
	for i in range(mini(count,order.size())): out.append(pool[order[i]])
	return out

static func describe(code: String,m: Dictionary) -> String:
	return text(code,"t_"+String(m.stat)).replace("%d",str(int(m.goal)))

