## The language the game is running in, set by main_3d when the player picks one.
static var lang:="en"

static func text(key: String,code:="") -> String:
	var c:=lang if code=="" else code
	var table: Dictionary=T.get(c,T["en"])
	return String(table.get(key,T["en"].get(key,key)))

static func fmt(key: String,n: int,code:="") -> String:
	return text(key,code).replace("%d",str(n))

## A font for 3D labels that also covers Chinese / Japanese / Korean and other scripts.
static var _font: Font
static func font() -> Font:
	if _font==null:
		var base:=(load("res://assets/fonts/hud_condensed_bold.otf") as FontFile).duplicate() as FontFile
		var fallbacks: Array[Font]=[]
		if ResourceLoader.exists("res://assets/fonts/hud_cjk_black.otf"): fallbacks.append(load("res://assets/fonts/hud_cjk_black.otf"))
		var system:=SystemFont.new(); system.font_names=PackedStringArray(["PingFang SC","Hiragino Sans","Apple SD Gothic Neo","Microsoft YaHei","Noto Sans CJK SC","Noto Sans","Segoe UI","Arial"])
		fallbacks.append(system); base.fallbacks=fallbacks
		_font=base
	return _font
