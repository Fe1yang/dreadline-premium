const LANGUAGE_CURRENCY:={"zh":"CNY","ja":"JPY","ko":"KRW","ru":"RUB","uk":"UAH","pl":"PLN",
	"tr":"TRY","hi":"INR","id":"IDR","th":"THB","vi":"VND","pt":"BRL","ar":"SAR",
